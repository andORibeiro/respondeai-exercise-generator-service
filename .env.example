# Porta do servidor
PORT=3000

# Conexão com MongoDB Atlas
MONGODB_URI=mongodb+srv://<USUARIO>:<SENHA>@<CLUSTER>.mongodb.net/respondeai_exercises?retryWrites=true&w=majority

# Caminho do arquivo de credenciais Firebase (Admin SDK JSON)
FIREBASE_CREDENTIALS_PATH=./respondeai-firebase-adminsdk.json

# Chave da API Gemini (Google Generative AI)
GEMINI_API_KEY=sua_chave_gemini
